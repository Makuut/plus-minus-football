{
  "manifest_version": 3,
  "name": "Plus Minus Football",
  "description": "Анализ футбольных ТТД по игрокам, командам и периодам.",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Открыть анализ футбола"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "video-hotkeys.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
